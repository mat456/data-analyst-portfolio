---
import BaseLayout from '../layouts/BaseLayout.astro';

const tableauUrl = 'https://public.tableau.com/app/profile/lengrand/viz/AmazonAdsPerformanceAnalytics/Overview';
const ocrGithubUrl = 'https://github.com/mat456/ocr-receipt-intelligence-pipeline';
const bogachevUrl = 'https://wc26.bogachev.fr/index.html';
---

<BaseLayout
  title="Mathieu Lengrand — Data Analyst"
  description="Data Analyst portfolio focused on SQL, data quality, business intelligence and data visualization."
>
  <header class="site-header shell">
    <a class="brand" href="#top" aria-label="Back to top">
      <span class="brand-mark">ML</span>
      <span class="brand-copy">
        <strong>Mathieu Lengrand</strong>
        <small>DATA ANALYST</small>
      </span>
    </a>

    <nav aria-label="Main navigation">
      <a href="#projects"><span>01</span> Projects</a>
      <a href="#about"><span>02</span> About</a>
      <a href="https://github.com/mat456" target="_blank" rel="noreferrer"><span>03</span> GitHub ↗</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero shell">
      <div class="hero-system-row">
        <div class="eyebrow"><span class="signal-dot"></span> DATA ANALYST · LYON, FRANCE</div>
        <div class="system-readout" aria-label="Analytics workflow">
          <span>RAW</span><b>→</b><span>STAGING</span><b>→</b><span>MART</span><b>→</b><span>INSIGHTS</span>
        </div>
      </div>

      <h1>Turning raw data into <span>clear decisions.</span></h1>
      <p class="hero-copy">
        I build reliable analytics workflows — from data preparation and quality checks
        to business metrics and decision-ready visualizations.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href="#projects">Explore projects <span>→</span></a>
        <a class="button button-secondary" href={tableauUrl} target="_blank" rel="noreferrer">
          Tableau Public ↗
        </a>
      </div>

      <div class="skill-row" aria-label="Core skills">
        <span>Python</span>
        <span>SQL</span>
        <span>Tableau</span>
        <span>Streamlit</span>
        <span>Data Visualization</span>
        <span>Data Storytelling</span>
      </div>
    </section>

    <section class="projects shell" id="projects">
      <div class="section-heading">
        <p>01 / SELECTED WORK</p>
        <h2>Projects built around real analytical problems.</h2>
      </div>

      <article class="featured-project">
        <div class="project-copy">
          <div class="project-statusline">
            <div class="project-index"><span class="status-dot"></span> PROJECT_01 / FEATURED</div>
            <div class="project-state"><span class="state-led"></span> STATUS: LIVE</div>
          </div>

          <h3>Amazon Ads Performance Analytics</h3>
          <p class="project-lead">
            An analytics project designed to monitor advertising performance and profitability
            across automatic, manual keyword and product targeting campaigns.
          </p>

          <p class="project-description">
            The reporting focuses on the metrics that connect media performance to business value:
            CTR, CPC, conversion rate, ACOS, ROAS and profit. The objective is to identify which
            campaigns and targeting approaches deserve more investment — and which ones do not.
          </p>

          <div class="tags" aria-label="Technologies used">
            <span>PostgreSQL</span>
            <span>SQL</span>
            <span>Tableau</span>
            <span>Data Quality</span>
          </div>

          <a class="text-link" href={tableauUrl} target="_blank" rel="noreferrer">
            View interactive dashboard on Tableau Public <span>↗</span>
          </a>
        </div>

        <a
          class="dashboard-preview dashboard-preview-link"
          href={tableauUrl}
          target="_blank"
          rel="noreferrer"
          aria-label="Open the Amazon Ads dashboard on Tableau Public"
        >
          <div class="preview-topbar">
            <div>
              <small class="preview-id">VIEW_01 / TABLEAU</small>
              <span>Executive overview</span>
            </div>
            <span class="preview-pill">Live dashboard</span>
          </div>

          <div class="dashboard-image-shell">
            <img
              src="/images/amazon-dashboard-preview.webp"
              alt="Amazon Ads Tableau dashboard showing attributed sales, spend, ad profit, ROAS, ACOS, orders and campaign performance charts"
              loading="lazy"
              decoding="async"
            />
          </div>

        </a>
      </article>

      <article class="ocr-project">
        <div class="ocr-copy">
          <div class="project-statusline">
            <div class="project-index">
              <span class="status-dot"></span>
              PROJECT_02 / DATA PIPELINE
            </div>

            <div class="project-state">
              <span class="state-led"></span>
              STATUS: REAL-WORLD USE CASE
            </div>
          </div>

          <h3>OCR Receipt Intelligence Pipeline</h3>

          <p class="project-lead">
            A Python pipeline designed to transform noisy OCR output from customer receipts
            into validated and structured purchase data.
          </p>

          <p class="project-description">
            The workflow combines rule-based processing and LLM-assisted extraction to identify
            retailers, products and prices, while applying data quality controls before generating
            structured datasets ready for analysis.
          </p>

          <div class="tags">
            <span>Python</span>
            <span>Pandas</span>
            <span>OCR</span>
            <span>Data Quality</span>
            <span>LLM</span>
          </div>

          <a
            class="text-link"
            href={ocrGithubUrl}
            target="_blank"
            rel="noreferrer"
          >
            View project on GitHub <span>↗</span>
          </a>
        </div>

        <div class="ocr-preview">
          <div class="ocr-preview-header">
            <span>PIPELINE_02 / RECEIPT PROCESSING</span>
            <span class="ocr-preview-status">Validated</span>
          </div>

          <div class="ocr-flow">
            <span>OCR</span>
            <b>→</b>
            <span>PARSE</span>
            <b>→</b>
            <span>CLEAN</span>
            <b>→</b>
            <span>VALIDATE</span>
            <b>→</b>
            <span>ENRICH</span>
          </div>

          <div class="ocr-example">
            <div class="ocr-raw">
              <small>RAW OCR / SYNTHETIC EXAMPLE</small>

              <pre>SAINSBURYS
JS STPAWBS 4OOG
£2.7S
Nectar Pr1ce Saving
-£1.OO
ONKEN NAT Y0G 450G
£1.35
T0TAL £3.1O</pre>
            </div>

            <div class="ocr-transform-arrow">→</div>

            <div class="ocr-structured">
              <small>STRUCTURED DATA</small>

              <dl>
                <div>
                  <dt>RETAILER</dt>
                  <dd>Sainsbury's</dd>
                </div>

                <div>
                  <dt>PRODUCT</dt>
                  <dd>Strawberries 400g</dd>
                </div>

                <div>
                  <dt>PRICE</dt>
                  <dd>£2.75</dd>
                </div>

                <div>
                  <dt>STATUS</dt>
                  <dd class="validated-value">
                    <span class="state-led"></span>
                    VALIDATED
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </article>

      <article class="momentum-project">
        <div class="momentum-copy">
          <div class="project-statusline">
            <div class="project-index">
              <span class="status-dot"></span>
              PROJECT_03 / FOOTBALL ANALYTICS
            </div>

            <div class="project-state project-state-muted">
              <span class="state-led"></span>
              STATUS: PUBLISHED
            </div>
          </div>

          <h3>Football Momentum Visualization</h3>

          <p class="project-lead">
            An interactive visualization designed to reveal how the balance of a football match
            evolves over time.
          </p>

          <p class="project-description">
            Traditional match statistics describe what happened, but often fail to show when control
            shifted from one team to another. This project transforms event data into a continuous
            momentum signal, making periods of pressure, attacking dominance and changes in match
            dynamics easier to perceive.
          </p>

          <div class="tags">
            <span>Python</span>
            <span>Event Data</span>
            <span>Data Visualization</span>
            <span>Interactive Viz</span>
          </div>

          <p class="project-credit">
            Visualization concept inspired by
            <a href={bogachevUrl} target="_blank" rel="noreferrer">
              Alexandre Bogachev ↗
            </a>
          </p>
        </div>

        <div class="momentum-preview" aria-label="Football momentum visualization preview">
          <div class="momentum-preview-header">
            <div>
              <small class="preview-id">VIEW_03 / MATCH MOMENTUM</small>
              <span>PSG vs Arsenal · Match dynamics</span>
            </div>

            <span class="momentum-preview-pill">Event data</span>
          </div>

          <div class="momentum-video-shell">
            <video
              class="momentum-video"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster="/images/football-momentum-poster.webp"
            >
              <source
                src="/videos/PSG_vs_Arsenal_Football_Momentum.mp4"
                type="video/mp4"
              />

              Your browser does not support the video tag.
            </video>
          </div>
        </div>
      </article>
    </section>

    <section class="about shell" id="about">
      <div class="section-heading compact">
        <p>02 / ABOUT</p>
        <h2>Analytics with a business-first mindset.</h2>
      </div>

      <div class="about-layout">
        <div class="about-copy">
          <p>
            Data Analyst with a background in actuarial consulting and several years of experience
            working with business data, reporting and data quality topics.
          </p>
          <p>
            I enjoy translating ambiguous questions into clear analytical frameworks, reliable metrics
            and visualizations that make decisions easier.
          </p>
        </div>

        <dl class="profile-console" aria-label="Profile overview">
          <div><dt>LOCATION</dt><dd>Lyon, France</dd></div>
          <div><dt>FOCUS</dt><dd>Analytics / BI / Data Quality</dd></div>
          <div><dt>CORE</dt><dd>Python / SQL / Tableau</dd></div>
          <div><dt>MODE</dt><dd><span class="state-led"></span> Business-first</dd></div>
        </dl>
      </div>
    </section>
  </main>

  <footer class="shell footer">
    <span>Mathieu Lengrand · Data Analyst</span>
    <span>SYSTEM END // 2026 · Built with Astro</span>
  </footer>
</BaseLayout>
