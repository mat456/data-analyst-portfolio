---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props as Props;

const tableauUrl = 'https://public.tableau.com/app/profile/lengrand/viz/AmazonAdsPerformanceAnalytics/Overview';
const ocrGithubUrl = 'https://github.com/mat456/ocr-receipt-intelligence-pipeline';
const githubUrl = 'https://github.com/mat456';
const bogachevUrl = 'https://wc26.bogachev.fr/index.html';

const copy = {
  fr: {
    seo: {
      title: 'Mathieu Lengrand — Data Analyst | Portfolio',
      description:
        'Portfolio Data Analyst de Mathieu Lengrand : Python, SQL, Tableau, data quality, business intelligence et visualisation de données.'
    },
    nav: {
      projects: 'Projets',
      about: 'À propos',
      github: 'GitHub',
      aria: 'Navigation principale'
