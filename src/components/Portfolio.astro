---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props as Props;

const tableauUrl = 'https://public.tableau.com/app/profile/lengrand/viz/AmazonAdsPerformanceAnalytics/Overview';
const ocrGithubUrl = 'https://github.com/mat456/ocr-receipt-intelligence-pipeline';
const githubUrl = 'https://github.com/mat456';
const bogachevUrl = 'https://wc26.bogachev.fr/index.html';

const copy = {
  fr: {
    seo: {
      title: 'Mathieu Lengrand — Data Analyst | Portfolio',
      description:
        'Portfolio Data Analyst de Mathieu Lengrand : Python, SQL, Tableau, data quality, business intelligence et visualisation de données.'
    },
    nav: {
      projects: 'Projets',
      about: 'À propos',
      github: 'GitHub',
      aria: 'Navigation principale'
    },
    hero: {
      eyebrow: 'DATA ANALYST · LYON, FRANCE',
      workflowAria: 'Workflow analytique',
      titleStart: 'Transformer les données brutes en',
      titleHighlight: 'informations exploitables.',
      copy:
        'Je construis des workflows analytiques fiables — de la préparation et des contrôles qualité jusqu’aux indicateurs métier et aux visualisations conçues pour faciliter la décision.',
      projectsCta: 'Découvrir les projets',
      skillsAria: 'Compétences principales',
      skills: ['Python', 'SQL', 'Tableau', 'Streamlit', 'Visualisation de données', 'Data Storytelling']
    },
    selectedWork: {
      label: '01 / PROJETS SÉLECTIONNÉS',
      title: 'Des projets construits autour de problématiques analytiques concrètes.'
    },
    amazon: {
      index: 'PROJET_01 / À LA UNE',
      status: 'STATUT : EN LIGNE',
      title: 'Amazon Ads Performance Analytics',
      lead:
        'Un projet d’analyse conçu pour suivre la performance publicitaire et la rentabilité des campagnes automatiques, manuelles par mots-clés et de ciblage produit.',
      description:
        'Le reporting se concentre sur les indicateurs qui relient performance média et valeur business : CTR, CPC, taux de conversion, ACOS, ROAS et profit. L’objectif est d’identifier les campagnes et les approches de ciblage qui méritent davantage d’investissement — et celles qui n’en méritent pas.',
      technologiesAria: 'Technologies utilisées',
      cta: 'Voir le dashboard interactif sur Tableau Public',
      previewAria: 'Ouvrir le dashboard Amazon Ads sur Tableau Public',
      previewView: 'Vue d’ensemble',
      previewBadge: 'Dashboard en ligne',
      imageAlt:
        'Dashboard Tableau Amazon Ads présentant les ventes attribuées, les dépenses, le profit publicitaire, le ROAS, l’ACOS, les commandes et la performance des campagnes'
    },
    ocr: {
      index: 'PROJET_02 / PIPELINE DE DONNÉES',
      status: 'STATUT : CAS D’USAGE RÉEL',
      title: 'OCR Receipt Intelligence Pipeline',
      lead:
        'Un pipeline Python conçu pour transformer des sorties OCR bruitées issues de tickets de caisse en données d’achat validées et structurées.',
      description:
        'Le workflow combine des règles métier et l’extraction assistée par LLM pour identifier les enseignes, les produits et les prix, puis applique des contrôles de qualité avant de produire des jeux de données structurés prêts pour l’analyse.',
      cta: 'Voir le projet sur GitHub',
      previewTitle: 'PIPELINE_02 / TRAITEMENT DES TICKETS',
      previewStatus: 'Validé',
      flow: {
        parse: 'EXTRAIRE',
        clean: 'NETTOYER',
        validate: 'VALIDER',
        enrich: 'ENRICHIR'
      },
      rawLabel: 'OCR BRUT / EXEMPLE SYNTHÉTIQUE',
      structuredLabel: 'DONNÉES STRUCTURÉES',
      retailer: 'ENSEIGNE',
      product: 'PRODUIT',
      price: 'PRIX',
      statusLabel: 'STATUT',
      validated: 'VALIDÉ'
    },
    momentum: {
      index: 'PROJET_03 / FOOTBALL ANALYTICS',
      status: 'STATUT : PUBLIÉ',
      title: 'Football Momentum Visualization',
      lead:
        'Une visualisation interactive conçue pour montrer comment le rapport de force d’un match de football évolue dans le temps.',
      description:
        'Les statistiques traditionnelles décrivent ce qui s’est passé, mais montrent difficilement à quel moment le contrôle du match bascule d’une équipe à l’autre. Ce projet transforme les données événementielles en un signal continu de momentum afin de rendre plus lisibles les périodes de pression, de domination offensive et les changements de dynamique.',
      creditStart: 'Concept de visualisation inspiré du travail d’',
      previewAria: 'Aperçu de la visualisation du momentum du match',
      previewTitle: 'PSG vs Arsenal · Dynamique du match',
      previewBadge: 'Données événementielles',
      videoFallback: 'Votre navigateur ne prend pas en charge la lecture de cette vidéo.'
    },
    about: {
      label: '02 / À PROPOS',
      title: 'L’analyse de données avec une approche orientée métier.',
      p1:
        'Data Analyst avec une expérience en conseil actuariel et plusieurs années de pratique autour des données métier, du reporting et de la qualité des données.',
      p2:
        'J’aime transformer des questions parfois ambiguës en cadres d’analyse clairs, en indicateurs fiables et en visualisations qui facilitent la prise de décision.',
      consoleAria: 'Aperçu du profil',
      location: 'LOCALISATION',
      locationValue: 'Lyon, France',
      focus: 'FOCUS',
      focusValue: 'Analytics / BI / Qualité des données',
      core: 'CORE',
      coreValue: 'Python / SQL / Tableau',
      mode: 'MODE',
      modeValue: 'Orienté métier'
    }
  },
  en: {
    seo: {
      title: 'Mathieu Lengrand — Data Analyst | Portfolio',
      description:
        'Data Analyst portfolio focused on Python, SQL, Tableau, data quality, business intelligence and data visualization.'
    },
    nav: {
      projects: 'Projects',
      about: 'About',
      github: 'GitHub',
      aria: 'Main navigation'
    },
    hero: {
      eyebrow: 'DATA ANALYST · LYON, FRANCE',
      workflowAria: 'Analytics workflow',
      titleStart: 'Turning raw data into',
      titleHighlight: 'clear decisions.',
      copy:
        'I build reliable analytics workflows — from data preparation and quality checks to business metrics and decision-ready visualizations.',
      projectsCta: 'Explore projects',
      skillsAria: 'Core skills',
      skills: ['Python', 'SQL', 'Tableau', 'Streamlit', 'Data Visualization', 'Data Storytelling']
    },
    selectedWork: {
      label: '01 / SELECTED WORK',
      title: 'Projects built around real analytical problems.'
    },
    amazon: {
      index: 'PROJECT_01 / FEATURED',
      status: 'STATUS: LIVE',
      title: 'Amazon Ads Performance Analytics',
      lead:
        'An analytics project designed to monitor advertising performance and profitability across automatic, manual keyword and product targeting campaigns.',
      description:
        'The reporting focuses on the metrics that connect media performance to business value: CTR, CPC, conversion rate, ACOS, ROAS and profit. The objective is to identify which campaigns and targeting approaches deserve more investment — and which ones do not.',
      technologiesAria: 'Technologies used',
      cta: 'View interactive dashboard on Tableau Public',
      previewAria: 'Open the Amazon Ads dashboard on Tableau Public',
      previewView: 'Executive overview',
      previewBadge: 'Live dashboard',
      imageAlt:
        'Amazon Ads Tableau dashboard showing attributed sales, spend, ad profit, ROAS, ACOS, orders and campaign performance charts'
    },
    ocr: {
      index: 'PROJECT_02 / DATA PIPELINE',
      status: 'STATUS: REAL-WORLD USE CASE',
      title: 'OCR Receipt Intelligence Pipeline',
      lead:
        'A Python pipeline designed to transform noisy OCR output from customer receipts into validated and structured purchase data.',
      description:
        'The workflow combines rule-based processing and LLM-assisted extraction to identify retailers, products and prices, while applying data quality controls before generating structured datasets ready for analysis.',
      cta: 'View project on GitHub',
      previewTitle: 'PIPELINE_02 / RECEIPT PROCESSING',
      previewStatus: 'Validated',
      flow: {
        parse: 'PARSE',
        clean: 'CLEAN',
        validate: 'VALIDATE',
        enrich: 'ENRICH'
      },
      rawLabel: 'RAW OCR / SYNTHETIC EXAMPLE',
      structuredLabel: 'STRUCTURED DATA',
      retailer: 'RETAILER',
      product: 'PRODUCT',
      price: 'PRICE',
      statusLabel: 'STATUS',
      validated: 'VALIDATED'
    },
    momentum: {
      index: 'PROJECT_03 / FOOTBALL ANALYTICS',
      status: 'STATUS: PUBLISHED',
      title: 'Football Momentum Visualization',
      lead:
        'An interactive visualization designed to reveal how the balance of a football match evolves over time.',
      description:
        'Traditional match statistics describe what happened, but often fail to show when control shifted from one team to another. This project transforms event data into a continuous momentum signal, making periods of pressure, attacking dominance and changes in match dynamics easier to perceive.',
      creditStart: 'Visualization concept inspired by',
      previewAria: 'Football momentum visualization preview',
      previewTitle: 'PSG vs Arsenal · Match dynamics',
      previewBadge: 'Event data',
      videoFallback: 'Your browser does not support the video tag.'
    },
    about: {
      label: '02 / ABOUT',
      title: 'Analytics with a business-first mindset.',
      p1:
        'Data Analyst with a background in actuarial consulting and several years of experience working with business data, reporting and data quality topics.',
      p2:
        'I enjoy translating ambiguous questions into clear analytical frameworks, reliable metrics and visualizations that make decisions easier.',
      consoleAria: 'Profile overview',
      location: 'LOCATION',
      locationValue: 'Lyon, France',
      focus: 'FOCUS',
      focusValue: 'Analytics / BI / Data Quality',
      core: 'CORE',
      coreValue: 'Python / SQL / Tableau',
      mode: 'MODE',
      modeValue: 'Business-first'
    }
  }
} as const;

const t = copy[lang];
const canonicalPath = lang === 'fr' ? '/' : '/en/';
---

<BaseLayout
  title={t.seo.title}
  description={t.seo.description}
  lang={lang}
  canonicalPath={canonicalPath}
>
  <header class="site-header shell">
    <a class="brand" href="#top" aria-label={lang === 'fr' ? 'Retour en haut de page' : 'Back to top'}>
      <span class="brand-mark">ML</span>
      <span class="brand-copy">
        <strong>Mathieu Lengrand</strong>
        <small>DATA ANALYST</small>
      </span>
    </a>

    <div class="header-tools">
      <nav aria-label={t.nav.aria}>
        <a href="#projects"><span>01</span> {t.nav.projects}</a>
        <a href="#about"><span>02</span> {t.nav.about}</a>
        <a href={githubUrl} target="_blank" rel="noreferrer"><span>03</span> {t.nav.github} ↗</a>
      </nav>

      <div class="language-switch" aria-label={lang === 'fr' ? 'Choix de la langue' : 'Language selector'}>
        <a href="/" class={lang === 'fr' ? 'active' : undefined} aria-current={lang === 'fr' ? 'page' : undefined}>
          FR
        </a>
        <span>/</span>
        <a href="/en/" class={lang === 'en' ? 'active' : undefined} aria-current={lang === 'en' ? 'page' : undefined}>
          EN
        </a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="hero shell">
      <div class="hero-system-row">
        <div class="eyebrow">
          <span class="signal-dot"></span>
          {t.hero.eyebrow}
        </div>

        <div class="system-readout" aria-label={t.hero.workflowAria}>
          <span>RAW</span><b>→</b><span>STAGING</span><b>→</b><span>MART</span><b>→</b><span>INSIGHTS</span>
        </div>
      </div>

      <h1>{t.hero.titleStart} <span>{t.hero.titleHighlight}</span></h1>

      <p class="hero-copy">{t.hero.copy}</p>

      <div class="hero-actions">
        <a class="button button-primary" href="#projects">
          {t.hero.projectsCta} <span>→</span>
        </a>

        <a class="button button-secondary" href={tableauUrl} target="_blank" rel="noreferrer">
          Tableau Public ↗
        </a>
      </div>

      <div class="skill-row" aria-label={t.hero.skillsAria}>
        {t.hero.skills.map((skill) => <span>{skill}</span>)}
      </div>
    </section>

    <section class="projects shell" id="projects">
      <div class="section-heading">
        <p>{t.selectedWork.label}</p>
        <h2>{t.selectedWork.title}</h2>
      </div>

      <article class="featured-project">
        <div class="project-copy">
          <div class="project-statusline">
            <div class="project-index">
              <span class="status-dot"></span>
              {t.amazon.index}
            </div>

            <div class="project-state">
              <span class="state-led"></span>
              {t.amazon.status}
            </div>
          </div>

          <h3>{t.amazon.title}</h3>

          <p class="project-lead">{t.amazon.lead}</p>

          <p class="project-description">{t.amazon.description}</p>

          <div class="tags" aria-label={t.amazon.technologiesAria}>
            <span>PostgreSQL</span>
            <span>SQL</span>
            <span>Tableau</span>
            <span>Data Quality</span>
          </div>

          <a class="text-link" href={tableauUrl} target="_blank" rel="noreferrer">
            {t.amazon.cta} <span>↗</span>
          </a>
        </div>

        <a
          class="dashboard-preview dashboard-preview-link"
          href={tableauUrl}
          target="_blank"
          rel="noreferrer"
          aria-label={t.amazon.previewAria}
        >
          <div class="preview-topbar">
            <div>
              <small class="preview-id">VIEW_01 / TABLEAU</small>
              <span>{t.amazon.previewView}</span>
            </div>

            <span class="preview-pill">{t.amazon.previewBadge}</span>
          </div>

          <div class="dashboard-image-shell">
            <img
              src="/images/amazon-dashboard-preview.webp"
              alt={t.amazon.imageAlt}
              loading="lazy"
              decoding="async"
            />
          </div>
        </a>
      </article>

      <article class="ocr-project">
        <div class="ocr-copy">
          <div class="project-statusline">
            <div class="project-index">
              <span class="status-dot"></span>
              {t.ocr.index}
            </div>

            <div class="project-state">
              <span class="state-led"></span>
              {t.ocr.status}
            </div>
          </div>

          <h3>{t.ocr.title}</h3>

          <p class="project-lead">{t.ocr.lead}</p>

          <p class="project-description">{t.ocr.description}</p>

          <div class="tags">
            <span>Python</span>
            <span>Pandas</span>
            <span>OCR</span>
            <span>Data Quality</span>
            <span>LLM</span>
          </div>

          <a class="text-link" href={ocrGithubUrl} target="_blank" rel="noreferrer">
            {t.ocr.cta} <span>↗</span>
          </a>
        </div>

        <div class="ocr-preview">
          <div class="ocr-preview-header">
            <span>{t.ocr.previewTitle}</span>
            <span class="ocr-preview-status">{t.ocr.previewStatus}</span>
          </div>

          <div class="ocr-flow">
            <span>OCR</span>
            <b>→</b>
            <span>{t.ocr.flow.parse}</span>
            <b>→</b>
            <span>{t.ocr.flow.clean}</span>
            <b>→</b>
            <span>{t.ocr.flow.validate}</span>
            <b>→</b>
            <span>{t.ocr.flow.enrich}</span>
          </div>

          <div class="ocr-example">
            <div class="ocr-raw">
              <small>{t.ocr.rawLabel}</small>

              <pre>SAINSBURYS
JS STPAWBS 4OOG
£2.7S
Nectar Pr1ce Saving
-£1.OO
ONKEN NAT Y0G 450G
£1.35
T0TAL £3.1O</pre>
            </div>

            <div class="ocr-transform-arrow">→</div>

            <div class="ocr-structured">
              <small>{t.ocr.structuredLabel}</small>

              <dl>
                <div>
                  <dt>{t.ocr.retailer}</dt>
                  <dd>Sainsbury's</dd>
                </div>

                <div>
                  <dt>{t.ocr.product}</dt>
                  <dd>Strawberries 400g</dd>
                </div>

                <div>
                  <dt>{t.ocr.price}</dt>
                  <dd>£2.75</dd>
                </div>

                <div>
                  <dt>{t.ocr.statusLabel}</dt>
                  <dd class="validated-value">
                    <span class="state-led"></span>
                    {t.ocr.validated}
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </article>

      <article class="momentum-project">
        <div class="momentum-copy">
          <div class="project-statusline">
            <div class="project-index">
              <span class="status-dot"></span>
              {t.momentum.index}
            </div>

            <div class="project-state project-state-muted">
              <span class="state-led"></span>
              {t.momentum.status}
            </div>
          </div>

          <h3>{t.momentum.title}</h3>

          <p class="project-lead">{t.momentum.lead}</p>

          <p class="project-description">{t.momentum.description}</p>

          <div class="tags">
            <span>Python</span>
            <span>Event Data</span>
            <span>Data Visualization</span>
            <span>Interactive Viz</span>
          </div>

          <p class="project-credit">
            {t.momentum.creditStart}{' '}
            <a href={bogachevUrl} target="_blank" rel="noreferrer">
              Alexandre Bogachev ↗
            </a>
          </p>
        </div>

        <div class="momentum-preview" aria-label={t.momentum.previewAria}>
          <div class="momentum-preview-header">
            <div>
              <small class="preview-id">VIEW_03 / MATCH MOMENTUM</small>
              <span>{t.momentum.previewTitle}</span>
            </div>

            <span class="momentum-preview-pill">{t.momentum.previewBadge}</span>
          </div>

          <div class="momentum-video-shell">
            <video
              class="momentum-video"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            >
              <source
                src="/videos/PSG_vs_Arsenal_Football_Momentum.mp4"
                type="video/mp4"
              />

              {t.momentum.videoFallback}
            </video>
          </div>
        </div>
      </article>
    </section>

    <section class="about shell" id="about">
      <div class="section-heading compact">
        <p>{t.about.label}</p>
        <h2>{t.about.title}</h2>
      </div>

      <div class="about-layout">
        <div class="about-copy">
          <p>{t.about.p1}</p>
          <p>{t.about.p2}</p>
        </div>

        <dl class="profile-console" aria-label={t.about.consoleAria}>
          <div>
            <dt>{t.about.location}</dt>
            <dd>{t.about.locationValue}</dd>
          </div>

          <div>
            <dt>{t.about.focus}</dt>
            <dd>{t.about.focusValue}</dd>
          </div>

          <div>
            <dt>{t.about.core}</dt>
            <dd>{t.about.coreValue}</dd>
          </div>

          <div>
            <dt>{t.about.mode}</dt>
            <dd><span class="state-led"></span> {t.about.modeValue}</dd>
          </div>
        </dl>
      </div>
    </section>
  </main>

  <footer class="shell footer">
    <span>Mathieu Lengrand · Data Analyst</span>
    <span>SYSTEM END // 2026 · Built with Astro</span>
  </footer>
</BaseLayout>
